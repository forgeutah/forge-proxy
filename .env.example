# forge-proxy environment template.
#
# Copy to /etc/forge-proxy.env on your exe.dev VM, fill in the real values,
# then either:
#   - Reference from a systemd unit via `EnvironmentFile=/etc/forge-proxy.env`
#   - Or pass to the binary: `forge-proxy --env-file /etc/forge-proxy.env`
#
# Values already present in the process environment win over this file
# (godotenv default), so the shell can still override individual keys for
# debugging without editing the file.
#
# Lines starting with # are comments. Quoted values support spaces.

# --- Network -----------------------------------------------------------------

LISTEN_ADDR=:8080
BASE_DOMAIN=forgeut.dev
AUTH_HOST=auth.forgeut.dev

# Per-app routing, with an optional required-roles allowlist.
#   Entry separator:  ;  (so role lists can use commas)
#   Target separator: |  (so the host assignment can use =)
#
# The host side matches the inbound Host header; the URL side is the upstream
# the proxy forwards to (reachable via Tailscale or your private network).
#
# An entry with a role list is reachable only by users holding at least one of
# those roles — the proxy denies before forwarding, so the app never sees the
# request. Grant roles with `forge-proxy admin set-roles` BEFORE adding the
# list, or you will lock everyone out.
#
# An entry with no `|` is reachable by any signed-in workspace member. That is
# the default and the pre-gating behaviour.
#
# Note the `;` separator: an older comma-separated value will be rejected at
# startup with a message naming the migration.
UPSTREAMS=deuce.forgeut.dev=http://deuce:8080|ai-dev,admin;platform.forgeut.dev=http://platform:8080

# --- Slack OIDC --------------------------------------------------------------

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# The "T"-prefixed Slack team ID for your workspace. Find it in Slack:
# desktop app -> workspace name -> Tools & settings -> Workspace settings,
# or the URL https://<workspace>.slack.com/admin (it's in the page source
# as team_id). Real IDs are ~9-11 alphanumeric chars after the T.
#
# This value is passed as `team=<id>` on the Slack authorize URL so users
# skip the workspace picker. Slack silently ignores invalid IDs — if your
# users still see the picker after signing in, double-check this value.
SLACK_TEAM_ID=T_REPLACE_ME

# --- Storage -----------------------------------------------------------------

# Parent directory must exist and be writable by the user running the binary.
DB_PATH=/var/lib/forge-proxy/forge.db

# --- Trust -------------------------------------------------------------------

# Generate with: openssl rand -hex 32
# Same value must be configured on every upstream app so they can validate
# the X-Forge-Proxy-Secret header. Rotation is a coordinated redeploy.
PROXY_SECRET=

# --- Tunables (all optional) -------------------------------------------------

# Absolute cap on session age. Default: 720h (30 days).
# SESSION_LIFETIME=720h

# Sliding idle timeout. Default: 336h (14 days). Must be ≤ SESSION_LIFETIME.
# SESSION_IDLE_TIMEOUT=336h

# Where signed-in users land at the auth host root without an explicit
# return_to. Default: https://<AUTH_HOST>/
# DEFAULT_LANDING_URL=https://auth.forgeutah.tech/

# Log verbosity. One of: debug | info | warn | error. Default: info.
# LOG_LEVEL=info

# --- Litestream backup (optional) --------------------------------------------
# Only needed if you're running the Litestream sidecar for off-host backups.
# Uncomment + fill in if you've set up the bucket per the README.

# R2_ACCOUNT_ID=
# R2_BUCKET=forge-proxy-backups
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
