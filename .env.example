# forge-proxy environment template.
#
# Copy to /etc/forge-proxy.env on your exe.dev VM, fill in the real values,
# then either:
#   - Reference from a systemd unit via `EnvironmentFile=/etc/forge-proxy.env`
#   - Or pass to the binary: `forge-proxy --env-file /etc/forge-proxy.env`
#
# Values already present in the process environment win over this file
# (godotenv default), so the shell can still override individual keys for
# debugging without editing the file.
#
# Lines starting with # are comments. Quoted values support spaces.

# --- Network -----------------------------------------------------------------

LISTEN_ADDR=:8080
BASE_DOMAIN=forgeut.dev
AUTH_HOST=auth.forgeut.dev

# Comma-separated host=URL pairs. The host side matches the inbound Host
# header; the URL side is the upstream the proxy forwards to (reachable via
# Tailscale or your private network).
UPSTREAMS=deuce.forgeut.dev=http://deuce:8080,platform.forgeut.dev=http://platform:8080

# --- Slack OIDC --------------------------------------------------------------

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# The "T"-prefixed Slack team ID for your workspace. Find it in Slack:
# desktop app -> workspace name -> Tools & settings -> Workspace settings,
# or the URL https://<workspace>.slack.com/admin (it's in the page source
# as team_id). Real IDs are ~9-11 alphanumeric chars after the T.
#
# This value is passed as `team=<id>` on the Slack authorize URL so users
# skip the workspace picker. Slack silently ignores invalid IDs — if your
# users still see the picker after signing in, double-check this value.
SLACK_TEAM_ID=T_REPLACE_ME

# --- Storage -----------------------------------------------------------------

# Parent directory must exist and be writable by the user running the binary.
DB_PATH=/var/lib/forge-proxy/forge.db

# --- Trust -------------------------------------------------------------------

# Generate with: openssl rand -hex 32
# Same value must be configured on every upstream app so they can validate
# the X-Forge-Proxy-Secret header. Rotation is a coordinated redeploy.
PROXY_SECRET=

# --- Tunables (all optional) -------------------------------------------------

# Absolute cap on session age. Default: 720h (30 days).
# SESSION_LIFETIME=720h

# Sliding idle timeout. Default: 336h (14 days). Must be ≤ SESSION_LIFETIME.
# SESSION_IDLE_TIMEOUT=336h

# Where signed-in users land at the auth host root without an explicit
# return_to. Default: https://<AUTH_HOST>/
# DEFAULT_LANDING_URL=https://auth.forgeutah.tech/

# Log verbosity. One of: debug | info | warn | error. Default: info.
# LOG_LEVEL=info

# --- SSH proxy (optional — leave SSH_UPSTREAMS empty to disable) ------------
# Per-upstream listener configuration.
#   Entry separator: ; (so role lists can use commas)
#   Target separator: | (so port assignment can use =)
# Format: port=host:port|role1,role2;port=host:port|role
# SSH_UPSTREAMS=2222=deuce.tailnet:22|ai-dev;2223=platform.tailnet:22|admin,ops
#
# A port RANGE exposes several proxy ports that all forward to the same host,
# port-preserving: inbound 2300 -> deuce.tailnet:2300, 2301 -> :2301, and so
# on. This is for a VM running one container sshd per port.
#   Format: lowPort-highPort=host|role1,role2
#   - The target is a BARE HOST. The upstream port is always the inbound
#     port, so writing "host:22" here is an error rather than a silent
#     reinterpretation.
#   - One role list governs the whole range.
#   - Capped at 256 ports; every port binds its own listener.
#   - Open the whole range on the firewall, and keyscan every port in it
#     into SSH_KNOWN_HOSTS_PATH (the proxy verifies each host:port it dials).
# SSH_UPSTREAMS=2300-2310=deuce.tailnet|ai-dev
#
# Both forms can appear in one value, separated by ';':
# SSH_UPSTREAMS=2222=box.tailnet:22|ops;2300-2310=deuce.tailnet|ai-dev

# Ed25519 host key for the listener (auto-generated on first start).
# SSH_HOST_KEY_PATH=/var/lib/forge-proxy/ssh/host_ed25519_key

# Ed25519 CA key the proxy uses to mint short-TTL user certs presented
# upstream. Operator distributes the .pub half into each upstream sshd's
# TrustedUserCAKeys file. (auto-generated on first start)
# SSH_CA_KEY_PATH=/var/lib/forge-proxy/ssh/ca_ed25519_key

# Hand-curated OpenSSH known_hosts the proxy uses to verify outbound
# upstream host keys. Populate with `ssh-keyscan <upstream-host>`.
# SSH_KNOWN_HOSTS_PATH=/var/lib/forge-proxy/ssh/known_hosts

# Listener bind address (defaults to 0.0.0.0 = all interfaces).
# SSH_LISTEN_ADDR=0.0.0.0

# --- Litestream backup (optional) --------------------------------------------
# Only needed if you're running the Litestream sidecar for off-host backups.
# Uncomment + fill in if you've set up the bucket per the README.

# R2_ACCOUNT_ID=
# R2_BUCKET=forge-proxy-backups
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
